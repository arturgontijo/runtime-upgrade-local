{
  "name": "assethubupgrade",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "inspect": "node scripts/inspect-moonbase.mjs",
    "fetch:wasm": "node scripts/fetch-onchain-runtime-wasm.mjs",
    "chopsticks:xcm": "node node_modules/@acala-network/chopsticks/chopsticks.cjs xcm -r configs/moonbase-relay.yml -p configs/moonbase-asset-hub.yml",
    "chopsticks:xcm:wasm": "node node_modules/@acala-network/chopsticks/chopsticks.cjs xcm -r configs/moonbase-relay.yml -p configs/moonbase-asset-hub.wasm-override.yml",
    "chopsticks:layer-a": "node scripts/layer-a-smoke.mjs",
    "chopsticks:layer-a:1017007": "sh -c 'test -n \"$WESTMINT_RUNTIME_WASM\" || (echo Set WESTMINT_RUNTIME_WASM to your westmint 1017007 .wasm; exit 1); EXPECT_SPEC=1017007 node scripts/layer-a-smoke.mjs'",
    "chopsticks:dry-run": "node scripts/layer-b-dry-run.mjs",
    "chopsticks:churn": "node scripts/layer-b-churn.mjs",
    "try-runtime:help": "node scripts/complement-try-runtime.mjs",
    "chopsticks:dev-authorize-upgrade": "node scripts/dev-storage-authorize-upgrade.mjs",
    "chopsticks:layer-b-relay": "node scripts/layer-b-relay-authorize-upgrade.mjs",
    "chopsticks:document-migrations": "node scripts/document-migrations.mjs",
    "chopsticks:reset-para": "rm -f .chopsticks-db-moonbase-asset-hub.sqlite .chopsticks-db-moonbase-asset-hub.sqlite-shm .chopsticks-db-moonbase-asset-hub.sqlite-wal",
    "chopsticks:reset-all": "rm -f .chopsticks-db-moonbase-asset-hub.sqlite* .chopsticks-db-moonbase-asset-hub-override.sqlite* .chopsticks-db-moonbase-relay.sqlite*",
    "zombienet:setup": "bash zombienet/scripts/setup.sh",
    "zombienet:build-fast-westend": "bash zombienet/scripts/build-westend-fast-runtime.sh",
    "zombienet:spawn": "cd zombienet && npx --yes @zombienet/cli@latest spawn network.toml --provider native",
    "zombienet:upgrade": "PARA_ID=1000 node zombienet/scripts/relay-authorize-upgrade.mjs",
    "zombienet:watch": "node zombienet/scripts/watch-para-spec.mjs",
    "zombienet:scrape-migrations": "node zombienet/scripts/scrape-para-migrations-from-log.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@polkadot/api": "^16.5.6"
  },
  "devDependencies": {
    "@acala-network/chopsticks": "^1.3.0"
  }
}
